APP_NAME=ASTRA Link

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
PRIMARY_LLM=gemini
FAST_LLM=groq
FALLBACK_LLM=groq

GEMINI_API_KEY=
GROQ_API_KEY=

# Model *preferences*, not hard requirements. The router discovers what each
# provider actually serves at runtime and picks the first preference that is
# available, so a retired model ID degrades gracefully instead of breaking.
# Comma-separated, highest preference first.
GEMINI_REASONING_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro
GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
GROQ_REASONING_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
GROQ_FAST_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b

# Browser-native Gemini Live audio. The API key always stays on the Mac.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
# Conservative defaults protect a free-tier Gemini project.
LIVE_MAX_CONCURRENT_SESSIONS=1
LIVE_MAX_SESSION_SECONDS=600
LIVE_MAX_DAILY_MINUTES=60
LIVE_CONTEXT_TRIGGER_TOKENS=25000
LIVE_CONTEXT_TARGET_TOKENS=8000
# Transcripts power the visualizer/history but add text tokens to Live usage.
LIVE_TRANSCRIPTIONS=true

# Public HTTPS origin assigned to the named tunnel, with no trailing slash.
# Leave blank for localhost-only use.
LINK_PUBLIC_URL=
# Comma-separated browser origins allowed to open the WebSocket.
LINK_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000
# Generate with: openssl rand -hex 32
LINK_SESSION_TOKEN=
# Optional absolute path. Defaults to ./web/out.
WEB_DIST_DIR=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
ASSISTANT_DATA_DIR=~/.astra-link

# Keep the footprint bounded. Old conversations are pruned past this age and
# logs rotate rather than grow.
MEMORY_RETENTION_DAYS=90
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=3

# ---------------------------------------------------------------------------
# Filesystem sandbox
# ---------------------------------------------------------------------------
# Every path argument is resolved through realpath and must land inside one of
# these roots. Colon-separated. Adding a root grants real access — be deliberate.
ALLOWED_DIRS=~/Documents/Projects

# ---------------------------------------------------------------------------
# Feature switches
# ---------------------------------------------------------------------------
ENABLE_SHELL_TOOLS=true
ENABLE_WEB_SEARCH=true
ENABLE_REMINDERS=true

# The permission broker enforces this independently of the model. Setting it
# false disables confirmation prompts for HIGH_RISK tools — do not.
REQUIRE_CONFIRMATION_FOR_DANGEROUS_TOOLS=true

# Ceiling on tool-call round trips within a single user turn.
MAX_AGENT_ITERATIONS=8

# Wall-clock ceiling for a single shell command, in seconds.
SHELL_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
# Used to resolve relative reminder times like "tomorrow at 9am".
TIMEZONE=Asia/Kolkata
